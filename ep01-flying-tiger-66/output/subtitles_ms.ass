Dialogue: 0,0:00:00.40,0:00:01.84,Sub,,0,0,0,,{\fad(80,80)}Korang tahu tak...
Dialogue: 0,0:00:02.11,0:00:04.79,Sub,,0,0,0,,{\fad(80,80)}Malaysia pernah menjadi lokasi satu tragedi
Dialogue: 0,0:00:04.79,0:00:06.65,Sub,,0,0,0,,{\fad(80,80)}melibatkan sebuah pesawat jumbo jet
Dialogue: 0,0:00:06.65,0:00:08.34,Sub,,0,0,0,,{\fad(80,80)}Boeing 747
Dialogue: 0,0:00:08.34,0:00:10.12,Sub,,0,0,0,,{\fad(80,80)}yang terhempas ketika menghampiri
Dialogue: 0,0:00:10.12,0:00:11.76,Sub,,0,0,0,,{\fad(80,80)}Lapangan Terbang Subang?
Dialogue: 0,0:00:11.71,0:00:12.81,Sub,,0,0,0,,{\fad(80,80)}Kejadian ini berlaku
Dialogue: 0,0:00:12.81,0:00:15.63,Sub,,0,0,0,,{\fad(80,80)}pada tahun 1989.
Dialogue: 0,0:00:15.78,0:00:19.36,Sub,,0,0,0,,{\fad(80,80)}Pada 19 Februari 1989,
Dialogue: 0,0:00:19.36,0:00:21.73,Sub,,0,0,0,,{\fad(80,80)}Flying Tiger Line Flight 66,
Dialogue: 0,0:00:21.73,0:00:24.53,Sub,,0,0,0,,{\fad(80,80)}sebuah Boeing 747-200F,
Dialogue: 0,0:00:24.53,0:00:27.41,Sub,,0,0,0,,{\fad(80,80)}dengan pendaftaran N807FT,
Dialogue: 0,0:00:27.41,0:00:29.12,Sub,,0,0,0,,{\fad(80,80)}sedang dalam perjalanan dari Singapura
Dialogue: 0,0:00:29.12,0:00:30.51,Sub,,0,0,0,,{\fad(80,80)}menuju ke Kuala Lumpur,
Dialogue: 0,0:00:30.51,0:00:33.14,Sub,,0,0,0,,{\fad(80,80)}sebelum meneruskan penerbangan ke Hong Kong.
Dialogue: 0,0:00:33.29,0:00:34.59,Sub,,0,0,0,,{\fad(80,80)}Ketika menghampiri Subang
Dialogue: 0,0:00:34.59,0:00:36.67,Sub,,0,0,0,,{\fad(80,80)}untuk mendarat di Runway 33,
Dialogue: 0,0:00:36.67,0:00:38.36,Sub,,0,0,0,,{\fad(80,80)}berlaku salah faham komunikasi
Dialogue: 0,0:00:38.36,0:00:41.52,Sub,,0,0,0,,{\fad(80,80)}antara juruterbang dan menara kawalan trafik udara.
Dialogue: 0,0:00:41.52,0:00:44.29,Sub,,0,0,0,,{\fad(80,80)}Arahan untuk turun ke 2,400 kaki...
Dialogue: 0,0:00:44.29,0:00:47.44,Sub,,0,0,0,,{\fad(80,80)}telah disalahertikan sebagai 400 kaki.
Dialogue: 0,0:00:47.44,0:00:48.61,Sub,,0,0,0,,{\fad(80,80)}Pesawat terus menurun...
Dialogue: 0,0:00:48.61,0:00:50.59,Sub,,0,0,0,,{\fad(80,80)}dan akhirnya melanggar kawasan berbukit
Dialogue: 0,0:00:50.59,0:00:52.13,Sub,,0,0,0,,{\fad(80,80)}berhampiran Puchong.
Dialogue: 0,0:00:52.38,0:00:54.04,Sub,,0,0,0,,{\fad(80,80)}Tragedi pada awal pagi itu...
Dialogue: 0,0:00:54.04,0:00:56.05,Sub,,0,0,0,,{\fad(80,80)}mengorbankan kesemua empat individu
Dialogue: 0,0:00:56.05,0:00:57.78,Sub,,0,0,0,,{\fad(80,80)}di dalam pesawat tersebut.
Dialogue: 0,0:00:58.03,0:00:59.87,Sub,,0,0,0,,{\fad(80,80)}Tragedi ini mengingatkan kita bahawa
Dialogue: 0,0:00:59.87,0:01:01.31,Sub,,0,0,0,,{\fad(80,80)}dalam dunia penerbangan,
Dialogue: 0,0:01:01.31,0:01:03.62,Sub,,0,0,0,,{\fad(80,80)}setiap arahan, dan setiap perkataan,
Dialogue: 0,0:01:03.62,0:01:04.89,Sub,,0,0,0,,{\fad(80,80)}membawa makna.
